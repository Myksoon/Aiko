# syntax=docker/dockerfile:1.7
#
# Aiko Core image (`aiko core`), built from the TypeScript workspace.
#
# Build context = repo root (ignore rules: /.dockerignore):
#   docker build -f deploy/Dockerfile.core -t aiko-core .

ARG NODE_IMAGE=node:24-bookworm-slim

# ---- 1. build ------------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS build
ENV PNPM_HOME=/pnpm \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=true
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /src

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm fetch

COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --offline --frozen-lockfile --filter "miyoria..." --filter "@miyoria/panel..."
RUN pnpm --filter @miyoria/panel build \
    && pnpm --filter miyoria build \
    && test -f packages/cli/dist/panel/index.html
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm --filter miyoria deploy --prod /out \
    && ls /out /out/node_modules

# ---- 2. runtime ----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime

LABEL org.opencontainers.image.title="aiko-core" \
      org.opencontainers.image.description="Aiko Core node (kernel, agent, Discord, admin API and panel)"

RUN apt-get update \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 aiko \
    && useradd --system --uid 10001 --gid aiko --home-dir /data --shell /usr/sbin/nologin aiko \
    && mkdir -p /data /profiles /etc/aiko \
    && chown -R aiko:aiko /data

COPY --from=build /out /opt/aiko
COPY --from=build /out/assets/profiles/ /profiles/
COPY deploy/aiko.docker.toml /etc/aiko/aiko.toml
RUN ln -s /opt/aiko/dist/main.js /usr/local/bin/aiko \
    && ln -s /opt/aiko/dist/main.js /usr/local/bin/miyoria

ENV NODE_ENV=production \
    MIYORIA_PANEL_DIR=/opt/aiko/dist/panel \
    MIYORIA_LOG_FORMAT=json

USER aiko:aiko
WORKDIR /data
VOLUME ["/data"]

EXPOSE 7878 7879 7882

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:7878/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]

ENTRYPOINT ["/usr/bin/tini", "--", "node", "/opt/aiko/dist/main.js", "--config", "/etc/aiko/aiko.toml"]
CMD ["core"]
