# Copy to deploy/.env if you want to override compose settings (all values are optional).
# Application secrets (LLM key, Discord tokens, API tokens) belong in the repo-root .env.

# Host ports of the core container (bound to 127.0.0.1 only).
#API_PORT=7878
#VOICE_LINK_PORT=7879
#STAGE_LINK_PORT=7882

# Image tag to build or pull.
#AIKO_IMAGE=aiko-core:local

# Custom container config path relative to deploy/.
#AIKO_CONFIG_FILE=./aiko.docker.toml

# Linux: match your host uid:gid so ../profiles stays writable.
#AIKO_UID=1000
#AIKO_GID=1000

# SQLite database inside the core-data volume.
#CORE_DATABASE_URL=sqlite:/data/aiko.db

# Log level: fatal | error | warn | info | debug | trace.
#AIKO_LOG_LEVEL=info
