# Copy to .env and fill in your keys (never commit .env to git).

# LLM (DeepSeek or any OpenAI-compatible API / proxy)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# Model IDs are configured in profiles/aiko/profile.toml under [llm.purposes]

# Discord bot account (text + slash commands)
DISCORD_BOT_TOKEN=
# Optional: Discord self-account token (only if using platform.discord.self)
DISCORD_SELF_TOKEN=
# Your Discord user ID (owner permissions; MIYORIA_OWNER_ID alias also supported)
AIKO_OWNER_ID=

# Admin API token (generated by setup/init or set a strong random string; MIYORIA_API_TOKEN alias also supported)
AIKO_API_TOKEN=

# Optional: Discord OAuth login for the web panel
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: tokens for remote voice/stage nodes
VOICE_LINK_TOKEN=
STAGE_LINK_TOKEN=

# Optional: Tavily web search key (falls back to DuckDuckGo when unset)
TAVILY_API_KEY=

# Optional: image generation API for draw_picture realistic photos
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=

# SQLite database path (sqlite:data/aiko.db = local file; memory:// = ephemeral)
DATABASE_URL=sqlite:data/aiko.db
